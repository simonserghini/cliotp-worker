{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cliotp-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",

  "vars": {
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_ALLOWED_EMAILS": ""
  },

  "routes": [
    { "pattern": "otp.serghini.me", "custom_domain": true }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "TotpStore" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TotpStore"] }
  ]
}
